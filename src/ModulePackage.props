<Project>
  <PropertyGroup>
    <Version>0.2.0-alpha.1</Version>
    <Authors>Sean Shaffer</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/SeanShaffer88/DiffBeacon</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../docs/MODULES.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
</Project>
